<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Translater_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Translater_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AlexTranslater"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SidePanelColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- Left: Main translator area -->
        <Grid Grid.Column="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0,140,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="16"
                Height="16"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Source="Assets/TranslateLogo.png" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="AlexTranslater" />
        </Grid>

        <!-- Main content - compact translator -->
        <Grid Grid.Row="1" Padding="12,0,12,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Language bar -->
            <Grid Grid.Row="0" Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="SourceLanguageCombo"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    FontSize="13"
                    SelectedIndex="0">
                    <ComboBoxItem Content="自动检测" Tag="auto" />
                    <ComboBoxItem Content="中文" Tag="zh" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>
                <Button
                    x:Name="SwapButton"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Margin="4,0"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="SwapLanguage_Click">
                    <SymbolIcon Symbol="Switch" />
                </Button>
                <ComboBox
                    x:Name="TargetLanguageCombo"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    FontSize="13"
                    SelectedIndex="1">
                    <ComboBoxItem Content="中文" Tag="zh" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>
                <Button
                    Grid.Column="3"
                    Width="32"
                    Height="32"
                    Margin="4,0,0,0"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="ScreenshotTranslate_Click"
                    ToolTipService.ToolTip="截屏翻译 (Alt+D)">
                    <SymbolIcon Symbol="Crop" />
                </Button>
            </Grid>

            <!-- Input area -->
            <Grid Grid.Row="1">
                <TextBox
                    x:Name="InputTextBox"
                    AcceptsReturn="True"
                    Padding="8,8,8,40"
                    FontSize="14"
                    PlaceholderText="输入文本..."
                    TextWrapping="Wrap" />
                <Button x:Name="SpeakInputButton" Width="28" Height="28" MinWidth="0" MinHeight="0"
                        Margin="6,0,0,6" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Background="Transparent" BorderBrush="Transparent" Click="Speak_Click"
                        AutomationProperties.Name="朗读原文" ToolTipService.ToolTip="朗读原文">
                    <SymbolIcon Symbol="Volume" />
                </Button>
                <Button
                    x:Name="TranslateButton"
                    Height="28"
                    Margin="0,0,6,6"
                    Padding="10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="Translate_Click"
                    CornerRadius="14"
                    Style="{StaticResource AccentButtonStyle}">
                    <TextBlock FontSize="12" Text="翻译" />
                </Button>
            </Grid>

            <!-- Divider -->
            <Border
                Grid.Row="2"
                Height="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Result area -->
            <Grid Grid.Row="3">
                <TextBox
                    x:Name="ResultTextBox"
                    Padding="8,8,8,40"
                    FontSize="14"
                    IsReadOnly="True"
                    PlaceholderText="翻译结果"
                    TextWrapping="Wrap" />
                <Button x:Name="SpeakResultButton" Width="28" Height="28" MinWidth="0" MinHeight="0"
                        Margin="6,0,0,6" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Background="Transparent" BorderBrush="Transparent" Click="Speak_Click"
                        AutomationProperties.Name="朗读译文" ToolTipService.ToolTip="朗读译文">
                    <SymbolIcon Symbol="Volume" />
                </Button>
                <Button
                    Width="28"
                    Height="28"
                    Margin="0,0,6,6"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="CopyResult_Click"
                    ToolTipService.ToolTip="复制">
                    <SymbolIcon Symbol="Copy" />
                </Button>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Padding="12,4,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="就绪" />
            <TextBlock
                x:Name="HotkeyHintText"
                Grid.Column="1"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="Alt+D 截屏翻译" />
            <Button
                x:Name="HistoryButton"
                Grid.Column="2"
                Width="18"
                Height="18"
                MinWidth="0"
                MinHeight="0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Click="HistoryButton_Click"
                ToolTipService.ToolTip="历史记录">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE823;" />
            </Button>
            <Button
                x:Name="SettingsButton"
                Grid.Column="3"
                Width="18"
                Height="18"
                MinWidth="0"
                MinHeight="0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Click="SettingsButton_Click"
                ToolTipService.ToolTip="设置">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE713;" />
            </Button>
        </Grid>
        </Grid>

        <!-- Right: Side panel -->
        <Border Grid.Column="1" x:Name="SidePanel" Visibility="Collapsed"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid Margin="0,32,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Side panel header -->
                <Grid Padding="12,8">
                    <TextBlock x:Name="SidePanelTitle" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent"
                            Padding="4" MinWidth="0" MinHeight="0" Click="CloseSidePanel_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <!-- Side panel content -->
                <ScrollViewer Grid.Row="1" Padding="12,0,12,12">
                    <StackPanel x:Name="SidePanelContent" Spacing="8" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
