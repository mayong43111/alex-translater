<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Translater_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Translater_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Translater"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="Medium"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Translater" />
            <Button
                Grid.Column="1"
                Width="28"
                Height="28"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="History_Click"
                ToolTipService.ToolTip="历史记录">
                <SymbolIcon Symbol="Clock" />
            </Button>
            <Button
                Grid.Column="2"
                Width="28"
                Height="28"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="Settings_Click"
                ToolTipService.ToolTip="设置">
                <SymbolIcon Symbol="Setting" />
            </Button>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" Padding="12,4,12,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Language selector bar (pill style) -->
            <Border
                Grid.Row="0"
                Padding="6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="SourceLanguageCombo"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        FontSize="13"
                        SelectedIndex="0">
                        <ComboBoxItem Content="自动检测" Tag="auto" />
                        <ComboBoxItem Content="中文" Tag="zh" />
                        <ComboBoxItem Content="English" Tag="en" />
                    </ComboBox>
                    <Button
                        x:Name="SwapButton"
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="SwapLanguage_Click"
                        CornerRadius="15"
                        ToolTipService.ToolTip="交换语言">
                        <SymbolIcon Symbol="Switch" />
                    </Button>
                    <ComboBox
                        x:Name="TargetLanguageCombo"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        FontSize="13"
                        SelectedIndex="1">
                        <ComboBoxItem Content="中文" Tag="zh" />
                        <ComboBoxItem Content="English" Tag="en" />
                    </ComboBox>
                    <Button
                        Grid.Column="3"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="ScreenshotTranslate_Click"
                        CornerRadius="15"
                        ToolTipService.ToolTip="截屏翻译 (Alt+D)">
                        <SymbolIcon Symbol="Crop" />
                    </Button>
                </Grid>
            </Border>

            <!-- Input card -->
            <Border
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <TextBox
                        x:Name="InputTextBox"
                        AcceptsReturn="True"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        FontSize="14"
                        Padding="12"
                        PlaceholderText="输入或粘贴文本..."
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,0,8,8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            Width="28"
                            Height="28"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="PasteFromClipboard_Click"
                            CornerRadius="14"
                            ToolTipService.ToolTip="粘贴">
                            <SymbolIcon Symbol="Paste" />
                        </Button>
                        <Button
                            x:Name="TranslateButton"
                            Height="30"
                            Padding="14,0"
                            Click="Translate_Click"
                            CornerRadius="15"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Forward" />
                                <TextBlock FontSize="12" Text="翻译" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Result card -->
            <Border
                Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <TextBox
                        x:Name="ResultTextBox"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        FontSize="14"
                        IsReadOnly="True"
                        Padding="12"
                        PlaceholderText="翻译结果"
                        TextWrapping="Wrap" />
                    <Button
                        Width="28"
                        Height="28"
                        Margin="0,0,8,8"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="CopyResult_Click"
                        CornerRadius="14"
                        ToolTipService.ToolTip="复制结果">
                        <SymbolIcon Symbol="Copy" />
                    </Button>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Grid Grid.Row="3" Padding="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="就绪" />
                <TextBlock
                    x:Name="HotkeyHintText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="Alt+D 截屏翻译" />
            </Grid>
        </Grid>
    </Grid>
</Window>
